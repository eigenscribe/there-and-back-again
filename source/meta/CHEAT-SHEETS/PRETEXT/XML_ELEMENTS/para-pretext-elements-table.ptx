<?xml version="1.0" encoding="UTF-8"?>

<paragraphs xml:id="para-pretext-elements-table" xmlns:xi="http://www.w3.org/2001/XInclude">
  <title>Comprehensive Element Categories</title>
  <p>
    PreTeXt organizes document components into clear structural, mathematical, computational, and backmatter layers:
  </p>

  <table>
    <title>PreTeXt Element Categories</title>
    <tabular bottom="minor" top="minor" left="minor" right="minor">
      <row header="yes">
        <cell>Category</cell>
        <cell>Elements</cell>
        <cell>Description</cell>
      </row>
      <row>
        <cell>Structure &amp; Divisions</cell>
        <cell><c>pretext</c>, <c>book</c>, <c>part</c>, <c>chapter</c>, <c>section</c>, <c>subsection</c>, <c>appendix</c></cell>
        <cell>High-level hierarchical document organization and divisions.</cell>
      </row>
      <row>
        <cell>Divisional Blocks</cell>
        <cell><c>introduction</c>, <c>conclusion</c>, <c>paragraphs</c></cell>
        <cell>Opening context, summaries, and unnumbered paragraphs groupings.</cell>
      </row>
      <row>
        <cell>Semantic Blocks</cell>
        <cell><c>theorem</c>, <c>lemma</c>, <c>definition</c>, <c>example</c>, <c>axiom</c>, <c>remark</c>, <c>project</c></cell>
        <cell>Formal mathematical environments defined in Chapter 15 (see dedicated Blocks subsection).</cell>
      </row>
      <row>
        <cell>Technical &amp; Figures</cell>
        <cell><c>program</c>, <c>image</c>, <c>table</c>, <c>tabular</c>, <c>figure</c>, <c>sidebyside</c></cell>
        <cell>Code listings, data tables, images, PreFigure widgets, and side-by-side layouts.</cell>
      </row>
      <row>
        <cell>Lists</cell>
        <cell><c>ul</c>, <c>ol</c>, <c>dl</c></cell>
        <cell>Unordered bulleted, ordered numbered, and description/definition lists.</cell>
      </row>
      <row>
        <cell>Backmatter &amp; Indexing</cell>
        <cell><c>idx</c>, <c>references</c>, <c>biblio</c>, <c>glossary</c>, <c>colophon</c></cell>
        <cell>Alphabetical index terms, citations, glossary items, and document metadata.</cell>
      </row>
    </tabular>
  </table>
</paragraphs>
