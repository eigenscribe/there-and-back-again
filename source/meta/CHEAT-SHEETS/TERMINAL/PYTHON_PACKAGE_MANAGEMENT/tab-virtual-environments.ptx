<?xml version="1.0" encoding="UTF-8"?>

<table xml:id="tab-virtual-environments" xmlns:xi="http://www.w3.org/2001/XInclude">
  <title>Virtual Environments</title>

  <tabular bottom="minor" top="minor" left="major" right="major">

    <row header="yes">
      <cell>Task</cell>
      <cell>pip/ venv</cell>
      <cell>uv</cell>
    </row>

    <row>
      <cell><em>Create <c>venv</c></em></cell>
      <cell>
        <cd>
          <cline>python -m venv .venv</cline>
        </cd>
      </cell>
      <cell>
        <cd>
          <cline>uv lock</cline>
        </cd>
        or automatic with
        <cd>
          <cline>uv pip compile</cline>
        </cd>
      </cell>
    </row>

    <row>
      <cell><em>Activate</em></cell>
      <cell>
        <cd>
          <cline>source .venv/bin/activate</cline>
        </cd>
      </cell>
      <cell>
        Not needed, can use
        <cd>
          <cline>uv run</cline>
        </cd>
      </cell>
    </row>

    <row>
      <cell><em>Run a script</em></cell>
      <cell>
        <cd>
          <cline>python script.py</cline>
        </cd>
        (in <c>venv</c>)
      </cell>
      <cell>
        <cd>
          <cline>uv run script.py</cline>
        </cd>
      </cell>
    </row>

    <row>
      <cell><em>Run a tool</em></cell>
      <cell>
        <cd>
          <cline>python -m pytest</cline>
        </cd>
      </cell>
      <cell>
        <cd>
          <cline>uv run pytest</cline>
        </cd>
      </cell>
    </row>

  </tabular>

</table>