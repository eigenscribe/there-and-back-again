<section xml:id="sec-git">
    <title>Terminal Cheat Sheet</title>
    <introduction>
        <p>
            <term>Note ID:</term> <tag>202604120002</tag> |
            <term>Tags:</term> <tag>git</tag> <tag>bash</tag> <tag>terminal</tag>
        </p>
    </introduction>

    <subsection xml:id="sub-git-local-reset">
        <title>Local Git Reset</title>
            <p>Multiline version (safter, less likely to accidentally earase local changes):</p>
            <program language="bash" line-numbers="no">
                <code>
                    <![CDATA[
                    git fetch origin
                    git checkout main        # or whatever branch you're using
                    git reset --hard origin/main
                    git clean -fd            # removes untracked files & folders
                    ]]>
                </code>
            </program>
            
            <p>One-liner (⚠️ use with caution!):</p>
            <program language="bash">
                 <code>
                    <![CDATA[
                    git fetch origin && git reset --hard origin/main && git clean -fd
                    ]]>
                 </code>
            </program>

    </subsection>

    <subsection xml:id="sub-pip-update-requirements">
        <title>Update pip requirements.txt</title>
        <program language="bash" line-numbers="no">
            <code>
                <![CDATA[ 
                pip install -r requirements.txt --upgrade
                pip freeze > requirements.txt
                ]]>
            </code>
        </program>
    </subsection>
</section>