<?xml version="1.0" encoding="UTF-8"?>

<subsection xml:id="subsec-data-geometry-map" xmlns:xi="http://www.w3.org/2001/XInclude">
  <title>Data Geometry Map</title>
  <introduction>
    <p>
      <alert>Note Id:</alert> <tag>202607310002</tag> | <alert>Tags:</alert>
      <tag>data analysis</tag> <tag>geometry</tag>
    </p>
  </introduction>

  <assemblage>
    <blockquote>
      <p>
        The computational methods and mathematical tools used to evaluate a dataset should be determined based on the
        geometry of the data.
      </p>
    </blockquote>
  </assemblage>

  <table xml:id="tab-data-geometry-map">
    <title>Data Geometry Map</title>

    <tabular bottom="minor" top="minor" left="major" right="minor">

      <col width = "20%"/>
      <col width = "20%"/>
      <col width = "20%"/>
      <col width = "20%"/>
      <col width = "20%"/>

      <row header="yes">
        <cell>Data structure</cell>
        <cell>Natural geometry</cell>
        <cell>Representation</cell>
        <cell>Analysis tools</cell>
      </row>

      <row>
        <cell><p>Measurements and signals</p></cell>

        <cell>
          <p>
            Euclidean vector space
          </p>
        </cell>

        <cell>
