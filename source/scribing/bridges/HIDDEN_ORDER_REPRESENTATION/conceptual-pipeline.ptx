<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE precept [
    <!ENTITY date "2026-07-02">
]>


<subsection xml:id="conceptual-pipeline" xmlns:xi="http://www.w3.org/2001/XInclude">
  <title>:ember: Concept Pipeline</title>

  <introduction>
    <p>
      <alert>Note Id:</alert> <tag>2026070201</tag>
    </p>
  </introduction>

  <figure xml:id="fig-concept-bridge">
    <image xml:id="mermaid-concept-bridge">
      <mermaid>
        graph LR
          S[<term>structure</term>] -- "Constraint 🔳" --> O[order]
          O -- "Formalization 🧩" --> R[representation]
          R -- "Inference 🧬" --> F[function]
      </mermaid>
    </image>
    <caption>
      <p>
        A mermaid diagram showing the <em>concept bridge</em> underlying measured data and the
        rules the govern it.
      </p>
    </caption>
  </figure>

  <assemblage>
    <title>:ember: Interpretation</title>

    <p>

    <dl>
      <li xml:id="def-structure">
        <title><term>Structure</term></title>
        <idx>structure</idx>

        <p>
          The underlying 'informational landscape' describing relations between
          <xref ref="def-physical-system" text="custom">physical systems</xref>.
        </p>

        <p>
          <em>Informational landscape</em> refers to the totality of relationships, constraints, and
          <xref ref="sec-physical-properties" text="custom">physical properties</xref> that characterize a
          <xref ref="def-physical-system" text="custom">physical system</xref> independently of any particular
          representation.
        </p>
      </li>

      <li xml:id="def-constraint-concept-bridge">
        <title><term>Constraint</term></title>
        <idx>constraint (concept bridge)</idx>

        <p>
          The rules, laws, symmetries, or boundary conditions that define the set of feasible states that may emerge from
          structure.
        </p>
      </li>

      <li xml:id="def-order">
        <title><term>Order</term></title>
        <idx>order</idx>

        <p>
          Patterns, regularities, and organization of <xref ref="sec-physical-properties" text="custom">physical
          properties</xref> that emerge from constraints on their structure.
        </p>
      </li>

      <li xml:id="def-formalization">
        <title><term>Formalization</term></title>
        <idx>formalization</idx>

        <p>
          The encoding of essential relationships between different
          <xref ref="sec-physical-properties" text="custom">physical properties</xref> into a
          mathematical language that preserves order.
        </p>
      </li>

      <li xml:id="def-representation">
        <title><term>Representation</term></title>
        <idx>representation</idx>

        <p>
          A mathematical formulation that describes
          <xref ref="def-physical-system" text="custom">physical systems</xref> and their properties.
        </p>
      </li>

      <li xml:id="def-inference">
        <title><term>Inference</term></title>
        <idx>inference</idx>

        <p>
          The logical deduction of physical behavior from a mathematical representation.
        </p>
      </li>

      <li xml:id="def-function">
        <title><term>Function</term></title>
        <idx>function (concept bridge)</idx>

        <p>
          Resulting behavior of <xref ref="def-physical-system" text="custom">physical systems</xref> that are
          expressed from the representation of the ordered information.
        </p>
      </li>
    </dl>

    </p>
  </assemblage>

</subsection>