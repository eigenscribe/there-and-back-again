<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE precept [
    <!ENTITY date "2026-07-02">
]>


<subsection xml:id="conceptual-pipeline" xmlns:xi="http://www.w3.org/2001/XInclude">
  <title>:ember: Concept Pipeline</title>

  <introduction>
    <p>
      <alert>Note Id:</alert> <tag>2026070201</tag>
    </p>
  </introduction>

  <figure xml:id="fig-concept-bridge">
    <image xml:id="mermaid-concept-bridge">
      <mermaid>
        graph LR
          S[structure] -- Constraint 🔳" --> O[order]
          O -- "Information ℹ️"" --> R[representation]
          R -- "Inference 🧬" --> F[function]
      </mermaid>
    </image>
    <caption>
      <p>
        A mermaid diagram showing the :ember: <term>concept bridge</term> underlying measured data and the
        rules the govern it.
      </p>
    </caption>
  </figure>

  <assemblage>
    <title>:ember: Interpretation</title>

    <p>

    <dl>
      <li xml:id="def-structure">
        <title><term>Structure</term></title>
        <idx>structure</idx>

        <p>
          The underlying 'informational landscape' describing relations between
          <xref ref="def-physical-system" text="custom">physical systems</xref>.
        </p>
      </li>

      <li xml:id="def-representation">
        <title><term>Representation</term></title>
        <idx>representation</idx>

        <p>
          A mathematical representation of that structure.
        </p>
      </li>

      <li xml:id="def-order">
        <title><term>Order</term></title>
        <idx>order</idx>

        <p>
          Patterns, regularities, and organization that emerges from the representation.
        </p>
      </li>

      <li xml:id="def-function">
        <title><term>Function</term></title>
        <idx>function (information pipeline)</idx>

        <p>
          Predictions that come from the order.
        </p>
      </li>
    </dl>

    </p>
  </assemblage>

</subsection>