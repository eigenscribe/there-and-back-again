<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE precept [
    <!ENTITY date "2026-07-02">
]>


<assemblage xml:id="conceptual-pipeline" xmlns:xi="http://www.w3.org/2001/XInclude">
  <title>Information Pipeline</title>

  <sidebyside xml:id="fig-information-pipeline">
    <image xml:id="mermaid-info-pipeline">
      <description>A mermaid diagram showing the information pipeline from measured data to function.</description>
      <mermaid>
        graph LR
          S[structure] -- "Bridge 🌉" --> R[representation]
          R -- "Crossing 👟" --> O[order]
          O --> F[function]
      </mermaid>
    </image>
  </sidebyside>

</assemblage>