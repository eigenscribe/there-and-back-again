        <subsubsection xml:id="subsubsec-wedge-product-angular-momentum">
            <title>Wedge Product and Angular Momentum</title>
            <claim>
                <p>
                    The <term>wedge product</term> captures oriented area and is analogous to angular momentum or flux in physical systems.
                </p>
            </claim>
        </subsubsection>

