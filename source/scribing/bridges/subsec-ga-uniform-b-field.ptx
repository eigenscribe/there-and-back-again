<?xml version="1.0" encoding="UTF-8"?>

<subsection xml:id="subsec-ga-uniform-b-field" xmlns:xi="http://www.w3.org/2001/XInclude">
    <title>Vector Potential for a Uniform Magnetic Field</title>

    <definition xml:id="def-ga-uniform-b-field-vector-potential">
        <title>Vector Potential</title>
        <idx><term>vector potential</term></idx>
        <statement>
            <p>
                For a uniform magnetic field <m>\vec{B}=B_0\mathbf{e}_z</m>, represented as a bivector <m>\bivec{B}=B_0(\mathbf{e}_x\wedge\mathbf{e}_y)</m>,
                the <term>vector potential</term> <m>\vec{A}</m> must satisfy
                <me>
                    \bivec{B}=\vec{\nabla}\wedge\vec{A} \, .
                </me>
            </p>
        </statement>
    </definition>

    Common gauge choices for a uniform magnetic field are:

       <dl>
            <dt>Symmetry Gauge</dt>
            <dd>
                Preserves rotational symmetry.
                <me>
                    \vec{A}_\text{sym}=\frac{B_0}{2}\left(x\mathbf{e}_x+y\mathbf{e}_y\right)
                </me>
            </dd>

            <dt>Landau Gauge</dt>
            <dd>
                Preserves translational symmetry along the <m>x</m>-axis.
                <me>
                    \vec{A}_\text{landau}=-B_0 y \mathbf{e}_x
                </me>
            </dd>

       </dl>

</subsection>
