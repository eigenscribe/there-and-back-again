<?xml version="1.0" encoding="UTF-8"?>

<section xml:id="sec-eulers-formula" xmlns:xi="http://www.w3.org/2001/XInclude">
  <title>One Formula to Rule Them All</title>

  <introduction>
    <p>
      <tag>202608250001</tag> |
      <tag>Euler's formula</tag>
    </p>
  </introduction>

  <context>
    <p>
      Take $i^2=-1$.
    </p>
  </context>

  <definition xml:id="def-eulers-formula">
    <title>Euler's Formula</title>
    <idx>euler's formula</idx>

    <statement>
      <md>
        e^{i x} = \cos(x) + i \sin(x), \quad i^2=-1
      </md>
    </statement>
  </definition>

  <identity>
    <title>Euler's Identity</title>

    <statement>
      <md>
        e^{i x} + 1 = 0
      </md>
    </statement>

  </identity>

</section>
