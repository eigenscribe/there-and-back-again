<?xml version="1.0" encoding="UTF-8"?>

<definition xml:id="def-dirac-delta" xmlns:xi="http://www.w3.org/2001/XInclude">
  <title>Dirac Delta Function</title>
  <idx>dirac delta function</idx>
  <statement>
    <p>
        The operational definition of the Dirac delta function can be written in terms of the <term>sifting property</term>:
        <md>
            \int_{-\infty}^{\infty}{\delta(t-a) f(t) \, dt} = f(a) \, .
        </md>
    </p>
  </statement>
 </definition>