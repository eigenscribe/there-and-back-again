<?xml version="1.0" encoding="UTF-8"?>

<glossary xml:id="gls-main" xmlns:xi="http://www.w3.org/2001/XInclude">
  <title>Glossary</title>

  <gi xml:id="gls-composition">
    <title>Composition</title>
    <idx>composition</idx>

    <statement>
      <p>
        Vectors whose components correspond with relative proportions of a whole.
      </p>
    </statement>
  </gi>

  <gi xml:id="gls-distribution">
    <title>Distribution</title>
    <idx>distribution</idx>
    <statement>
      <p>
        A mathematical description of how a quantity (e.g., a probability) is allocated across a set of outcomes or
        values.
      </p>
    </statement>
  </gi>

  <gi xml:id="gls-first-principles-logic">
    <title>First-Principles Reasoning</title>
    <idx>first-principles reasoning</idx>
    <statement>
        <p>
          A method of reasoning in which claims, hypotheses, models, or systems are explicitly decomposed into their
          most fundamental, independently verifiable assumptions, and conclusions are derived via transparent, stepwise
          inference based on those assumptions. This helps ensure the fidelity of the reasoning process and that
          conclusions are traceable and reproducible by the reader.
        </p>
    </statement>
  </gi>

  <gi xml:id="gls-function">
    <title>Function</title>
    <idx>function</idx>
    <statement>
      <p>
        A mapping <m>f:A\rightarrow B</m> from a domain <m>A</m> to a codomain <m>B</m>. Such mappings assign exactly
        one element <m>b\in B</m> (the <term>output</term>) to each element of the domain <m>a\in A</m> (the
        <term>input</term>). Importantly, these mappings may be surjective, injective, both (i.e., bijective),
        or neither.
      </p>
    </statement>
  </gi>

  <gi xml:id="gls-numerical-integration">
    <title>Numerical Integration</title>
    <idx>numerical integration</idx>
    <statement>
      <p>
        Methods for approximating definite integrals.
      </p>
    </statement>
  </gi>

  <gi xml:id="gls-poisson-brackets">
    <title>Poisson Bracket</title>
    <idx>Poisson bracket</idx>
    <statement>
      <p>
          Provides a fundamental operation in Hamiltonian mechanics and symplectic geometry.
          Specifically, it tells you how an observable <m>A</m> changes due to some other observable <m>B</m> acting as a generator.
      </p>
    </statement>
  </gi>

  <gi xml:id="gls-power-spectral-density">
    <title>Power Spectral Density</title>
    <idx>power spectral density</idx>

    <statement>
      <p>
          A function <m>S_{xx}(f)</m> describing how the power of a signal is distributed over frequency <m>f</m>.
      </p>
    </statement>
  </gi>

  <gi xml:id="gls-regression-methods">
    <title>Regression Methods</title>
    <idx>regression methods</idx>

    <statement>
      <p>
        Methods for fitting models to data.
      </p>
    </statement>
  </gi>

  <gi xml:id="gls-root-finding">
    <title>Root-Finding Algorithms</title>
    <idx>root-finding algorithms</idx>

    <statement>
      <p>
          Methods for solving equations of the form <m>f(x) = 0</m>.
      </p>
    </statement>
  </gi>

  <gi xml:id="gls-significant-figure">
    <title>Significant Figure</title>
    <idx>significant figure</idx>

    <statement>
      <p>
        A digit of a numerical value that contributes to the <xref ref="def-precision" text="custom">precision</xref> of
        a measurement and is therefore crucial for <xref ref="def-accuracy" text="custom">accurate</xref>
        interpretation.
      </p>
    </statement>
  </gi>

  <gi xml:id="gls-spurious-correlations">
    <title>Spurious Correlations</title>
    <idx>spurious correlations</idx>

    <statement>
      <em>Non-causal</em> correlations between variables that manifest due to third party factors.
    </statement>
  </gi>

  <gi xml:id="gls-support">
    <title>Support</title>
    <idx>support</idx>

    <p>
        The subset of the domain <m>X</m> of a function <m>f: X\rightarrow \mathbb{R}</m>
        on which the function is nonzero.
    </p>

    <md>
        \operatorname{supp}(f)
        =
        \{x \in X : f(x)\neq 0\}.
    </md>
  </gi>

</glossary>