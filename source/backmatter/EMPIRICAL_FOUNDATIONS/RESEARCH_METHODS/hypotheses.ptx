<?xml version="1.0" encoding="UTF-8"?>

<subsection xml:id="subsec-hypotheses" xmlns:xi="http://www.w3.org/2001/XInclude">
  <title>Hypotheses</title>
  <intro>
    <p>

    </p>
  </intro>

  <table xml:id="tab-hypothesis-errors">
    <title>Summary of Type I vs. Type II Errors <ft ref="footnote-hypothesis-errors"></ft></title>
    <idx>type I error</idx>
    <idx>type II error</idx>

    <tabular bottom="minor" top="minor" left="minor" right="minor">
      <col width="40%"/>
      <col width="30%"/>
      <col width="30%"/>
      <row header="yes">
        <cell>Decision</cell>
        <cell><m>H_0</m> is True</cell>
        <cell><m>H_0</m> is False</cell>
      </row>

      <row>
        <cell>
          <p>
            Decide to reject <m>H_0</m>
          </p>
        </cell>
        <cell>
          <p>
            <term>Type I error</term>
          </p>
        </cell>
        <cell>
          <p>
            ✔️
          </p>
        </cell>
      </row>

      <row>
        <cell>
          <p>
            Decide to accept <m>H_0</m>
          </p>
        </cell>
        <cell>
          <p>
            ✔️
          </p>
        </cell>
        <cell>
          <p>
            <term>Type II error</term>
          </p>
        </cell>
      </row>

    </tabular>

  </table>

<footnote id="footnote-hypothesis-errors">
    <p>
      <xref ref="tab-hypothesis-errors"/> is adapted from <xref ref="harrington2011design">Harrington, 2011.</xref>
    </p>
</footnote>

</subsection>