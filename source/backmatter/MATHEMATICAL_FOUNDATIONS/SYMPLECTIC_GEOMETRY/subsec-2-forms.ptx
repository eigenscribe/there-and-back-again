<?xml version="1.0" encoding="UTF-8"?>

<subsection xml:id="subsec-2-forms" xmlns:xi="http://www.w3.org/2001/XInclude">
  <title>2-Forms</title>

  <introduction>

  </introduction>

  <definition xml:id="def-2-form">
    <title>2-form</title>
    <idx>2-form</idx>
    <statement>
      <md>
        (dx \wedge dy)(\mathbf{v}_1, \mathbf{v}_2) = dx(\mathbf{v}_1)dy(\mathbf{v}_2) - dx(\mathbf{v}_2)dy(\mathbf{v}_1)
      </md>
    </statement>
    <note>
      <p>
        For this definition, we assume <m>\mathbf{v}_1</m> and <m>\mathbf{v}_1</m> are both 2D vectors.
      </p>
    </note>
  </definition>

</subsection>