<?xml version="1.0" encoding="UTF-8"?>

<paragraphs xml:id="para-sets-and-combinatorics-terminology" xmlns:xi="http://www.w3.org/2001/XInclude">
  <title>Terminology</title>

  <!-- Clean, Unnumbered 'Local Glossary' for Minor Terms -->
  <dl>
    <li xml:id="notation-universal-set">
      <title><term>Universal Set</term></title>

      <notation>
        <usage><m>\mathcal{U}</m></usage>
        <description>Universal set of all possible admissible states</description>
      </notation>

      <p>
        A context-specific domain (<m>\mathcal{U}</m>) containing all admissible elements that comprise a framework of
        interest.
      </p>
    </li>

    <li xml:id="notation-index-set">
      <title><term>Index Set</term></title>

      <notation>
        <usage><m>\mathcal{I}_n</m></usage>
        <description>Index set of elements</description>
      </notation>

      <p>
        A set <m>\mathcal{I}_n \cong \{1, 2, \dots, n\}, n\in\mathbb{Z}^+</m> that acts as a dedicated counting space used to label
        and track elements of others sets.
      </p>
    </li>

    <li xml:id="convention-sequence">
      <title><term>Sequence Convention</term></title>

      <notation>
        <usage><m>(a_k)_{k \in \mathcal{I}_n}</m></usage>
        <description>Sequence indexed by set <m>\mathcal{I}_n</m></description>
      </notation>

      <p>
        An ordered, repeatable list of terms that are mapped directly from an index space.
      </p>
    </li>
  </dl>

</paragraphs>