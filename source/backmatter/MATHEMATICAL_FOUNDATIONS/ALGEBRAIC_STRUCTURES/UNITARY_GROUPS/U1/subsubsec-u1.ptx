<subsubsection xml:id="subsubsec-unitary-group-u1" xmlns:xi="http://www.w3.org/2001/XInclude">
  <title><m>\operatorname{U}(1)</m></title>
  <idx><m>\operatorname{U}(1)</m></idx>s

  <introduction>
    <p>
      The unitary group <m>\operatorname{U}(1)</m> is the Lie group of all complex numbers with absolute value <m>1</m>
      under multiplication.
    </p>
  </introduction>

  <xi:include href="para-u1-complex-numbers.ptx"/>
  <xi:include href="para-u1-matrix-group.ptx"/>

</subsubsection>