<?xml version="1.0" encoding="UTF-8"?>

<paragraphs xml:id="para-wedge-product" xmlns:xi="http://www.w3.org/2001/XInclude">
  <title>Wedge (Exterior) Product</title>
  <idx><term>wedge product</term></idx>
  <idx><term>exterior product</term></idx>
  <idx><term>outer product</term></idx>

  <definition xml:id="def-wedge-product">
    <title>Wedge Product</title>

    <statement>
      <p>
        The <term>wedge product</term> (or <term>exterior product</term>) is a fundamental operation in geometric algebra that takes two
        vectors and outputs a <xref ref="def-bivector"><term>bivector</term></xref>.
      </p>
      <p>
        Given vectors in a 2D basis:
      </p>
      <md>
        <mrow>\mathbf{a} \amp = a^1\mathbf{e}_1 + a^2\mathbf{e}_2 = \begin{bmatrix} a^1 \\ a^2 \end{bmatrix}</mrow>
        <mrow>\mathbf{b} \amp = b^1\mathbf{e}_1 + b^2\mathbf{e}_2 = \begin{bmatrix} b^1 \\ b^2 \end{bmatrix}</mrow>
      </md>
      <!-- PREFIGURE IMAGE HERE -->
    </statement>
  </definition>

</paragraphs>
