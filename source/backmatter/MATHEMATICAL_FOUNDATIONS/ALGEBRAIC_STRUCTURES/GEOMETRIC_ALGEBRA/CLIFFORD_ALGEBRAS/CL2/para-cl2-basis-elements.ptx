<?xml version="1.0" encoding="UTF-8"?>

<paragraphs xml:id="para-cl2-basis-elements" xmlns:xi="http://www.w3.org/2001/XInclude">
  <title>Basis Elements</title>

  <dl>
    <li>
      <title><m>\{ 1 \}</m></title>
      <p>
        grade-0 object
      </p>
      <p>
        Corresponds with a scalar magnitudes.
      </p>
    </li>
    <li>
      <title><m>\{ \mathbf{e}_1, \mathbf{e}_2 \}</m></title>
      <p>
        grade-1 object
      </p>
      <p>
        Corresponds with a vector (i.e., directional information).
      </p>
    </li>
    <li>
      <title><m>\{ \mathbf{e}_{12} \}</m></title>
      <p>
        grade-2 objects
      </p>
      <p>
        Usually called <term>bivectors</term> or <term>wedge products</term>. The unit bivector is the pseudoscalar element in <m>\mathrm{Cl}(2)</m>.
      </p>
    </li>
  </dl>
</paragraphs>