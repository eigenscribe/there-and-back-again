<?xml version="1.0" encoding="UTF-8"?>

<paragraphs xml:id="para-cl03-basis-elements" xmlns:xi="http://www.w3.org/2001/XInclude">
  <title>Basis Elements</title>

  <dl>
    <li>
      <title><m>\{ 1 \}</m></title>
      <p>
        Grade-0 object
      </p>
      <p>
        Corresponds to scalar magnitudes.
      </p>
    </li>
    <li>
      <title><m>\{ \mathbf{e}_1, \mathbf{e}_2 , \mathbf{e}_3\}</m></title>
      <p>
        Grade-1 object
      </p>
      <p>
        Corresponds to vectors (directional information).
      </p>
    </li>
    <li>
      <title><m>\{ \mathbf{e}_{12}, \mathbf{e}_{23}, \mathbf{e}_{31} \}</m></title>
      <p>
        Grade-2 object
      </p>
      <p>
        Usually called <term>bivectors</term> or <term>wedge products</term>.
      </p>
    </li>
    <li>
      <title><m>\{ \mathbf{e}_{123} \}</m></title>
      <p>
        Grade-3 object
      </p>
      <p>
        Usually called <term>trivectors</term>. The unit trivector is the pseudoscalar element in <m>\operatorname{Cl}(0,3)</m>.
      </p>
    </li>
  </dl>
</paragraphs>