<paragraphs xml:id="finite-difference-comparison">
  <title>Comparison of Finite Difference Scheme Properties</title>
  <idx>forward difference</idx>
  <idx>backward difference</idx>
  <idx>central difference</idx>

  <introduction>
    The following lists summarize common finite difference schemes for first and second derivatives.
  </introduction>

  <paragraphs xml:id="first-order-finite-difference-schemes">
    <title>First-Derivative Finite Difference Schemes</title>

    <dl>
      <li>
        <title><term>Forward Difference</term></title>
        <p>
          <em>Error:</em> <m>\mathcal{O}(\Delta x)</m>
        </p>
        <p>
          <em>Grid points:</em> <m>1</m>
        </p>
        <p>
          <em>Formulation:</em>
          <md>
            \frac{df}{dx} \approx \frac{f(x+\Delta x) - f(x)}{\Delta x}
          </md>
        </p>
      </li>

      <li>
        <title><term>Backward Difference</term></title>
        <p>
          <em>Error:</em> <m>\mathcal{O}(\Delta x)</m>
        </p>
        <p>
          <em>Grid points:</em> <m>1</m>
        </p>
        <p>
          <em>Formulation:</em>
          <md>
            \frac{df}{dx} \approx \frac{f(x) - f(x-\Delta x)}{\Delta x}
          </md>
        </p>
      </li>

      <li>
        <title><term>Central Difference</term></title>
        <p>
          <em>Error:</em> <m>\mathcal{O}(\Delta x^2)</m>
        </p>
        <p>
          <em>Grid points:</em> <m>2</m>
        </p>
        <p>
          <em>Formulation:</em>
          <md>
            \frac{df}{dx} \approx \frac{f(x+\Delta x) - f(x-\Delta x)}{2\Delta x}
          </md>
        </p>
      </li>
    </dl>
  </paragraphs>

  <paragraphs xml:id="second-order-finite-difference-schemes">
    <title>Second-Derivative Finite Difference Schemes</title>

    <dl>
      <li>
        <title><term>Central Difference</term></title>
        <p>
          <em>Error:</em> <m>\mathcal{O}(\Delta x^2)</m>
        </p>
        <p>
          <em>Grid points:</em> <m>2</m>
        </p>
        <p>
          <em>Formulation:</em>
          <md>
            \frac{d^2f}{dx^2} \approx \frac{f(x+\Delta x) - 2f(x) + f(x-\Delta x)}{\Delta x^2}
          </md>
        </p>
      </li>
    </dl>
  </paragraphs>
</paragraphs>