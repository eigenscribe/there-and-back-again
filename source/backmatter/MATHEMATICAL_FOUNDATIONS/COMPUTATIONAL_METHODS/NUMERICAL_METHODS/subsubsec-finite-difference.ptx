<paragraphs xml:id="finite-difference-comparison">
  <title>Comparison of Finite Difference Scheme Properties</title>
  <idx>forward difference</idx>
  <idx>backward difference</idx>
  <idx>central difference</idx>

  <p>
    The following tables summarize common finite difference schemes for first and second derivatives.
  </p>

  <table xml:id="tab-first-derivative-finite-difference">
    <title>First-Derivative Finite Difference Schemes</title>

    <tabular bottom="minor" top="minor" left="minor" right="minor">
      <row header="yes">
        <cell>Scheme and Formulation</cell>
        <cell>Error</cell>
        <cell>Grid Points</cell>
      </row>

      <row>
        <cell>
          <p>
            <term>Forward Difference</term>
          </p>
          <p>
            <md>
              \frac{df}{dx} \approx \frac{f(x+\Delta x) - f(x)}{\Delta x}
            </md>
          </p>
        </cell>
        <cell>
          <m>\mathcal{O}(\Delta x)</m>
        </cell>
        <cell>
          <m>1</m>
        </cell>
      </row>

      <row>
        <cell>
          <p>
            <term>Backward Difference</term>
          </p>
          <p>
            <md>
              \frac{df}{dx} \approx \frac{f(x) - f(x-\Delta x)}{\Delta x}
            </md>
          </p>
        </cell>
        <cell>
          <m>\mathcal{O}(\Delta x)</m>
        </cell>
        <cell>
          <m>1</m>
        </cell>
      </row>

      <row>
        <cell>
          <p>
            <term>Central Difference</term>
          </p>
          <p>
            <md>
              \frac{df}{dx} \approx \frac{f(x+\Delta x) - f(x-\Delta x)}{2\Delta x}
            </md>
          </p>
        </cell>
        <cell>
          <m>\mathcal{O}(\Delta x^2)</m>
        </cell>
        <cell>
          <m>2</m>
        </cell>
      </row>
    </tabular>
  </table>

  <table xml:id="tab-second-derivative-finite-difference">
    <title>Second-Derivative Finite Difference Schemes</title>

    <tabular bottom="minor" top="minor" left="minor" right="minor">
      <row header="yes">
        <cell>Scheme and Formulation</cell>
        <cell>Error</cell>
        <cell>Grid Points</cell>
      </row>

      <row>
        <cell>
          <p>
            <term>Central Difference</term>
          </p>
          <p>
            <md>
              \frac{d^2f}{dx^2} \approx \frac{f(x+\Delta x) - 2f(x) + f(x-\Delta x)}{\Delta x^2}
            </md>
          </p>
        </cell>
        <cell>
          <m>\mathcal{O}(\Delta x^2)</m>
        </cell>
        <cell>
          <m>2</m>
        </cell>
      </row>
    </tabular>
  </table>
</paragraphs>