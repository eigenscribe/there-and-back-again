<?xml version="1.0" encoding="UTF-8"?>

<subsubsection xml:id="subsubsec-finite-difference" xmlns:xi="http://www.w3.org/2001/XInclude">
  <title>Finite Difference Schemes</title>
  <idx>finite-difference</idx>
  <!--
      <introduction>
       <p> introduction </p>
      </introduction>
  -->

  <table xml:id="tab-finite-difference">
      <title>Comparison of Finite Difference Scheme Properties</title>
      <idx>forward difference</idx>
      <idx>backward difference</idx>
      <idx>central difference</idx>

      <tabular bottom="minor" top="minor" left="minor" right="minor">

        <row header="yes">
          <cell>Type</cell>
          <cell>Order</cell>
          <cell>Formulation</cell>
          <cell>Error</cell>
          <cell>Grid Points</cell>
        </row>

        <row>
          <cell><term>Forward Difference</term></cell>
          <cell>first</cell>
          <cell>
            <p>
              <md>
                \frac{df}{dx} \approx \frac{f(x+\Delta x) + f(x)}{\Delta x}
              </md>
            </p>
          </cell>
          <cell>
            <p>
              <m>\mathcal{O}(\Delta x)</m>
            </p>
          </cell>
          <cell><m>1</m></cell>
        </row>

        <row>
          <cell><term>Backward Difference</term></cell>
          <cell>first</cell>
          <cell>
            <p>
              <md>
                \frac{df}{dx} \approx \frac{f(x) - f(x-\Delta x)}{\Delta x}
              </md>
            </p>
          </cell>
          <cell>
            <p>
              <m>\mathcal{O}(\Delta x)</m>
            </p>
          </cell>
          <cell><m>1</m></cell>
        </row>

        <row>
          <cell><term>Central Difference</term></cell>
          <cell>first</cell>
          <cell>
            <p>
              <md>
                \frac{df}{dx} \approx \frac{f(x+\Delta x) - f(x-\Delta x)}{2\Delta x}
              </md>
            </p>
          </cell>
          <cell>
            <p>
              <m>\mathcal{O}(\Delta x^2)</m>
            </p>
          </cell>
          <cell><m>2</m></cell>
        </row>

        <row>
          <cell><term>Central Difference</term></cell>
          <cell>Second</cell>
          <cell>
            <p>
              <md>
                \frac{d^2f}{dx^2} \approx ...
              </md>
            </p>
          </cell>
          <cell>
            <p>
              <m>\mathcal{O}(\Delta x^2)</m>
            </p>
          </cell>
          <cell>double check</cell>
        </row>

      </tabular>
    </table>

</subsubsection>