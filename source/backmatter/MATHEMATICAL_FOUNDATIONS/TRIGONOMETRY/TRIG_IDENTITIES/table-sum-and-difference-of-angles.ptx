<?xml version="1.0" encoding="UTF-8"?>

<table xml:id="table-angle-sum-and-difference-identities" xmlns:xi="http://www.w3.org/2001/XInclude">
  <title>Sum and Difference Identities</title>

  <tabular>

    <col width = "20%"/>
    <col width = "40%"/>
    <col width = "40%"/>

    <row header="yes">
      <cell>Function</cell>
      <cell>Sum of Angles</cell>
      <cell>Difference of Angles</cell>
    </row>

    <row>
      <cell>
        <p>Sine</p>
      </cell>
      <cell>
        <md>
          \sin{(\alpha + \beta)} = \sin{\alpha}\cos{\beta}+\cos{\alpha}\sin{\beta}
        </md>
      </cell>
      <cell>
        <md>
          \sin{(\alpha - \beta)} = \sin{\alpha}\cos{\beta}-\cos{\alpha}\sin{\beta}
        </md>
      </cell>
    </row>

    <row>
      <cell>
        <p>Cosine</p>
      </cell>
      <cell>
        <md>
          \cos{(\alpha + \beta)} = \cos{\alpha}\cos{\beta} - \sin{\alpha}\sin{\beta}
        </md>
      </cell>
      <cell>
        <md>
          \cos{(\alpha - \beta)} = \cos{\alpha}\cos{\beta} + \sin{\alpha}\sin{\beta}
        </md>
      </cell>
    </row>

    <row>
      <cell>
        <p>Tangent</p>
      </cell>
      <cell>
        <md>
          \tan{(\alpha + \beta)} = \frac{\tan\alpha+\tan\beta}{1-\tan\alpha\tan\beta}
        </md>
      </cell>
      <cell>
        <md>
          \tan{(\alpha - \beta)} = \frac{\tan\alpha-\tan\beta}{1+\tan\alpha\tan\beta}
        </md>
      </cell>
    </row>

  </tabular>

</table>

