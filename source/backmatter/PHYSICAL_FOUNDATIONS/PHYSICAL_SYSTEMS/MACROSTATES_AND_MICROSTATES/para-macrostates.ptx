<?xml version="1.0" encoding="UTF-8"?>

<paragraphs xml:id="para-macrostates" xmlns:xi="http://www.w3.org/2001/XInclude">
  <title>Macrostates</title>

  <definition xml:id="def-macrostate">
    <idx>macrostate</idx>
    <statement>
      <p>
        A <term>macrostate</term> is the complete specification of the measurable
        <xref ref="def-macroscopic-property" text="custom">macroscopic properties</xref> that characterize a
        <xref ref="def-physical-system" text="custom">physical system</xref> at a given instant.
      </p>
      <p>
        The collection of all <xref ref="def-state-variable" text="custom">state variables</xref> defines the
        macrostate of a <xref ref="def-physical-system" text="custom">physical system</xref>.
      </p>
    </statement>
  </definition>

  <example>
    <title>Macrostate examples</title>

    <p>
      <ul>
        <li>temperature</li>
        <li>pressure</li>
        <li>volume</li>
        <li>particle number</li>
        <li>charge</li>
        <li>electric potential</li>
        <li>magnetization</li>
      </ul>
    </p>
  </example>

</paragraphs>
