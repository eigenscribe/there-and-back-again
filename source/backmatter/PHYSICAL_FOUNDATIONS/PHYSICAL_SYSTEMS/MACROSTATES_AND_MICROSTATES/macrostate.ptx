<?xml version="1.0" encoding="UTF-8"?>

<definition xml:id="def-macrostate" xmlns:xi="http://www.w3.org/2001/XInclude">
  <title>Macrostates</title>
  <idx>macrostate</idx>

    <statement>
      <p>
        An observable <xref ref="sec-physical-properties" text="custom">physical property</xref> that characterizes a
        physical <xref ref="def-system" text="custom">system</xref> in a measurable way. We use
        <xref ref="def-state-variables" text="state variables"/> to describe a particular macrostate.
      </p>
    </statement>

</definition>