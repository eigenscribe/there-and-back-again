<?xml version="1.0" encoding="UTF-8"?>

<definition xml:id="def-microstate" xmlns:xi="http://www.w3.org/2001/XInclude">
  <title>Microstate</title>
  <idx>microstate</idx>

    <statement>
      <p>
        A <term>microstate</term> is a constituent 'bit' of information, all of which are needed to describe the
        <xref ref="def-macrostate" text="custom">macrostate</xref>.
      </p>
    </statement>

</definition>