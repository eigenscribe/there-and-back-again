<?xml version="1.0" encoding="UTF-8"?>

<paragraphs xml:id="para-microstates" xmlns:xi="http://www.w3.org/2001/XInclude">
  <title>Microstates</title>

  <definition xml:id="def-microstate">
    <idx>microstate</idx>
    <statement>
      <p>
        A <term>microstate</term> is a complete microscopic description of a
        <xref ref="def-physical-system" text="custom">physical system</xref> that specifies the
        state of every constituent <xref ref="def-degrees-of-freedom-physics" text="custom">degree of freedom</xref>.
      </p>
    </statement>
  </definition>

  <remark xml:id="remark-second-law-prelude">
    <statement>
      <p>
        Multiple different microstates may give rise to the same
        <xref ref="def-macrostate" text="custom">macrostate</xref>.
      </p>
    </statement>
  </remark>
</paragraphs>
