<?xml version="1.0" encoding="UTF-8"?>

<paragraphs xml:id="para-extensive-properties" xmlns:xi="http://www.w3.org/2001/XInclude">
  <title>Extensive Properties</title>

  <definition xml:id="def-extensive-property">
    <idx>extensive property</idx>
    <statement>
      <p>
        An <term>extensive property</term> is a property whose value is proportional to the <em>size</em> or
        <em>amount</em> of substance comprising the system.
      </p>
    </statement>
  </definition>

  <remark>
    <statement>
      <p>
        If two identical systems <m>A</m> and <m>B</m> are combined, their <em>extensive properties</em> sum
        together. For an extensive property <m>X</m> this can be mathematically represented as
      </p>
      <md>
        X(A+B) = X(A) + X(B) \, .
      </md>
   </statement>
  </remark>

  <example>
    <title>Examples of Extensive Properties</title>

    <p>
      <ul>
        <li>Mass</li>
        <li>Volume</li>
        <li>Internal energy</li>
        <li>Entropy</li>
        <li>Number of particles</li>
      </ul>
    </p>

  </example>

</paragraphs>