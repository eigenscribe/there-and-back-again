<?xml version="1.0" encoding="UTF-8"?>

<subsection xml:id="subsec-extensive-vs-intensive-properties" xmlns:xi="http://www.w3.org/2001/XInclude">
  <title>Extensive vs. Intensive Properties</title>

  <xi:include href="para-extensive.ptx"/>
  <xi:include href="para-intensive.ptx"/>

  <paragraphs>
    <title>Relation between extensive and intensive properties</title>

    <remark>
      <statement>
        <p>
          Often times, <em>intensive properties</em> are constructed from ratios or derivatives of
          <em>extensive properties</em>.
        </p>
      </statement>
    </remark>


  </paragraphs>

</subsection>