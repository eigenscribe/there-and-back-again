<?xml version="1.0" encoding="UTF-8"?>

<subsection xml:id="subsec-state-variables" xmlns:xi="http://www.w3.org/2001/XInclude">
  <title>State Variables</title>

  <introduction>
    <!-- insert intro here -->
  </introduction>

  <definition xml:id="def-state-variable">
    <idx>state variable</idx>
    <statement>
      <p>
        A <term>state variable</term> is a measurable property of a
        <xref ref="def-physical-system" text="custom">physical system</xref> whose value depends only on the equilibrium
        state of the system and not on the path taken to reach that state.
      </p>
    </statement>
  </definition>

  <remark>
    <statement>
      <p>
        State variables can be used to define <em>path-independent</em> changes in the
        <xref ref="def-macrostate" text="custom">macrostate</xref> of a system between two points in time.
      </p>
    </statement>
  </remark>

 </subsection>