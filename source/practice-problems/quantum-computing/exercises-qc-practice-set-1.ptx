<?xml version="1.0" encoding="UTF-8"?>

<exercises xml:id="exercises-qc-practice-set-1" xmlns:xi="http://www.w3.org/2001/XInclude">
    <title>Quantum Computing - Problem Set 1</title>
    <introduction>
        <title>Imports</title>
        <program language="python">
            <code>
                <![CDATA[
                from qiskit.quantum_info import Statevector, Operator
                import numpy as np
                from numpy import sqrt
                from IPython.display import display, Latex, Math

                from qiskit import __version__
                print(f"Qiskit version: {__version__}")
                ]]>    
            </code>
        </program>
    </introduction>

    <exercisegroup xml:id="eg-tensor-products">
        <title>Tensor Products</title>

        <exercise>
            <statement>
                <p>
                    Use Qiskit to compute the tensor product <m>\ket{-} \otimes \ket{i}</m>.
                    Your solution must construct the state and print out the amplitudes in the computational basis.
                </p>
            </statement>
            <hint>
                <p>
                    Use
                </p>
                <ul>
                    <li> <c>Statevector.from_label("-")</c> for <m>\ket{-}</m> </li>
                    <li> <c>Statevector.from_label("r")</c> for <m>\ket{i}</m> </li>
                </ul>
            </hint>
            <solution>
                <program language="python">
                    <code>
                    <![CDATA[
                    # Declare state vectors
                    minus = Statevector.from_label("-")
                    plus_i = Statevector.from_label("r")

                    # Compute the tensor product and display the result
                    display(minus.tensor(plus_i).draw("latex"))
                    ]]>
                    </code>
                </program>
            </solution>
            <answer>
                <p><m>\frac{1}{2} \ket{00} + \frac{i}{2} \ket{01} - \frac{1}{2} \ket{10} - \frac{i}{2} \ket{11}</m></p>
            </answer>
        </exercise>

        <exercise>
            <statement>
                <p>
                    Given the state <m>\ket{0} \otimes \ket{1} \otimes \ket{+}</m> write the state vector ordering explicitly.
                </p>
            </statement>
            <hint>
                <p>
                    🎗️ Qiskit starts its indexing (qubit 0) from the right-hand side.
                </p>
            </hint>
            <solution>
                <program language="python">
                    <code>
                    <![CDATA[
                    zero = Statevector([1, 0])
                    one = Statevector([0, 1])
                    plus = Statevector.from_label("+")

                    display((zero ^ one ^ plus).draw("latex"))
                    ]]>
                    </code>
                </program>
            </solution>
            <answer>
                <p><m>\frac{\sqrt{2}}{2}\ket{010} + \frac{\sqrt{2}}{2}\ket{011}</m></p>
            </answer>
        </exercise>
    
    </exercisegroup>
    
</exercises> 